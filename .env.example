# Copy this file to `.env.local` and put your real key in it.
#
#     cp .env.example .env.local
#
# `.env.local` is gitignored and `scripts/generate-art.mjs` refuses to run if it
# ever stops being ignored, so the key cannot be committed by accident.
#
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Optional. Defaults shown.
# GEMINI_MODEL=gemini-3.1-flash-image
# GEMINI_IMAGE_SIZE=1K
